# API binds to loopback by default for local development.
HOST=127.0.0.1
PORT=3000
CLQN_API_URL=http://127.0.0.1:3000
# Use local PostgreSQL or a managed PostgreSQL connection on GCP.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clqn
# Optional database connections per API process (default 10).
# DATABASE_POOL_SIZE=10

# Optional server-only root key for GitHub main-change notifications.
# Generate with: openssl rand -hex 32. Store privately; never set this on clients.
# GITHUB_WEBHOOK_SECRET=

# Optional API-side OAuth App client ID; enable Device Flow in GitHub settings.
# GITHUB_CLIENT_ID=

# Set only on the API server to run the orchestrator for every clan.
# OPENAI_API_KEY=
# CLQN_CLOUD_MODEL=gpt-5.4-mini
# CLQN_CLOUD_CALLS_PER_HOUR=120
