{
  "name": "clqn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/shared", "packages/api", "packages/mcp", "packages/cli"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run build && node --test --test-concurrency=1 packages/*/test/*.test.mjs",
    "dev": "npm run dev --workspace @clqn/api",
    "cli": "node packages/cli/dist/index.js",
    "db:generate": "npm run db:generate --workspace @clqn/api",
    "db:migrate": "npm run db:migrate --workspace @clqn/api",
    "user": "npm run user --workspace @clqn/api --"
  },
  "devDependencies": { "@types/node": "^22.0.0", "marked": "18.2.1", "typescript": "^5.9.0" }
}
