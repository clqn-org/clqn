{
  "name": "@clqn/api",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts",
    "db:cleanup": "node --env-file-if-exists=../../.env --import tsx src/cleanup.ts",
    "user": "node --env-file-if-exists=../../.env --import tsx src/manage-user.ts"
  },
  "dependencies": {
    "@clqn/shared": "0.1.2",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.19",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0"
  }
}
